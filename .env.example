# Absolute origin of the deployed site, no trailing path.
# Drives metadataBase, canonical URLs, Open Graph URLs, robots.txt and sitemap.xml.
# Without it, canonicals emit as relative paths and the sitemap is empty.
# Switching domains later is a change to this one value.
NEXT_PUBLIC_SITE_URL="https://ashwaniarya.vercel.app"

# Custom application inquiry form (server only, never NEXT_PUBLIC_). Set in Vercel, not in git.
# Resend API key for sending the inquiry email. Without it the form answers 503 and offers the email link.
RESEND_API_KEY=
# Recipient of inquiries. Defaults to ashwaniparker@gmail.com when unset.
SERVICE_INQUIRY_TO=
# Sender. Defaults to "Portfolio inquiries <onboarding@resend.dev>" until a domain is verified in Resend.
SERVICE_INQUIRY_FROM=
